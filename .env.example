# Configuración de la aplicación. Copiá a .env y ajustá.
# NINGÚN valor acá es secret en sí (el repo es público), pero no subas .env.

# Ruta de la base SQLite (por defecto data/app.db relativo a cwd).
# DATABASE_PATH=/app/data/app.db

# Puerto del server (lo usa react-router-serve; default 3000).
# PORT=3000

# Credenciales del admin que crea el seed SOLO si la base está vacía.
# SEED_ADMIN_EMAIL=admin@despensa.com.ar
# SEED_ADMIN_PASSWORD=cambiar-en-produccion

# En producción: SEED_ONLY_ADMIN=1 crea solo el admin (sin catálogo demo ni
# cliente de prueba). El catálogo real se carga a mano desde el panel.
# SEED_ONLY_ADMIN=1

# Días que se conservan los backups (default 7).
# BACKUP_RETENTION_DAYS=7

# Notificaciones al admin por Telegram (opcional; sin esto no se envían).
# Creá el bot con @BotFather, mandale /start y configurá aquí el token y tu chat_id.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# Dominio público del sitio (para links clickeables en las notificaciones).
# APP_URL=https://despensa.com.ar